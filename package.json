{
  "name": "pi-tool-duration",
  "version": "0.4.0",
  "description": "Make host-observed Pi tool-call timing visible to the model",
  "type": "module",
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "tool-duration",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-tool-duration.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-tool-duration/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-tool-duration#readme",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "extensions/tool-duration/index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/tool-duration"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "24.19.0",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
